<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <requires lib="gtk" version="4.0"/>
    <object class="GtkBox" id="main">
        <property name="orientation">horizontal</property>
        <property name="spacing">0</property>
        <child>
            <object class="GtkBox" id="sidebar_container">
                <property name="orientation">vertical</property>
                <property name="width_request">200</property>
                <property name="name">sidebar</property>
                <child>
                    <object class="GtkBox" id="sidebar_header">
                        <property name="orientation">vertical</property>
                        <property name="margin_start">16</property>
                        <property name="margin_end">16</property>
                        <property name="margin_top">24</property>
                        <property name="margin_bottom">16</property>
                        <property name="spacing">4</property>
                        <child>
                            <object class="GtkImage" id="sidebar_logo">
                                <property name="margin_bottom">8</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkLabel" id="sidebar_title">
                                <property name="label">Antergos NeXT</property>
                                <property name="css_classes">sidebar-title</property>
                                <property name="xalign">0</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkLabel" id="sidebar_subtitle">
                                <property name="label">Installer</property>
                                <property name="css_classes">sidebar-subtitle</property>
                                <property name="xalign">0</property>
                            </object>
                        </child>
                    </object>
                </child>
                <child>
                    <object class="GtkSeparator">
                        <property name="margin_start">12</property>
                        <property name="margin_end">12</property>
                    </object>
                </child>
                <child>
                    <object class="GtkScrolledWindow" id="steps_scrolled">
                        <property name="hexpand">True</property>
                        <property name="vexpand">True</property>
                        <child>
                            <object class="GtkListBox" id="steps_list">
                                <property name="css_classes">steps-list</property>
                                <property name="activate_on_single_click">True</property>
                                <property name="selection_mode">none</property>
                            </object>
                        </child>
                    </object>
                </child>
                <child>
                    <object class="GtkBox" id="about_section">
                        <property name="orientation">horizontal</property>
                        <property name="margin_start">12</property>
                        <property name="margin_end">12</property>
                        <property name="margin_bottom">4</property>
                        <child>
                            <object class="GtkButton" id="about_button">
                                <property name="label" translatable="yes">About</property>
                                <property name="css_classes">about-button</property>
                                <property name="hexpand">True</property>
                            </object>
                        </child>
                    </object>
                </child>
                <child>
                    <object class="GtkLabel" id="version_label">
                        <property name="margin_start">16</property>
                        <property name="margin_end">16</property>
                        <property name="margin_bottom">12</property>
                        <property name="xalign">0</property>
                        <property name="opacity">0.5</property>
                        <property name="css_classes">version-label</property>
                    </object>
                </child>
            </object>
        </child>
        <child>
            <object class="GtkBox" id="content_wrapper">
                <property name="orientation">vertical</property>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <child>
                    <object class="GtkBox" id="page_header_area">
                        <property name="orientation">vertical</property>
                        <property name="margin_start">24</property>
                        <property name="margin_end">24</property>
                        <property name="margin_top">24</property>
                        <property name="margin_bottom">8</property>
                        <child>
                            <object class="GtkLabel" id="page_subtitle">
                                <property name="xalign">0</property>
                                <property name="css_classes">page-subtitle</property>
                            </object>
                        </child>
                    </object>
                </child>
                <child>
                    <object class="GtkStack" id="main_stack">
                        <property name="hexpand">True</property>
                        <property name="vexpand">True</property>
                        <property name="transition_type">slide-left-right</property>
                        <property name="transition_duration">300</property>
                    </object>
                </child>
                <child>
                    <object class="GtkBox" id="progress_bar_box">
                        <property name="orientation">vertical</property>
                        <property name="margin_start">16</property>
                        <property name="margin_end">16</property>
                    </object>
                </child>
                <child>
                    <object class="GtkBox" id="bottom_bar">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="margin_start">16</property>
                        <property name="margin_end">16</property>
                        <property name="margin_top">8</property>
                        <property name="margin_bottom">12</property>
                        <child>
                            <object class="GtkButton" id="back_button">
                                <property name="label" translatable="yes">← Back</property>
                                <property name="css_classes">navigation-button back-button</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkLabel" id="step_counter">
                                <property name="hexpand">True</property>
                                <property name="xalign">0.5</property>
                                <property name="opacity">0.6</property>
                                <property name="css_classes">step-counter</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkButton" id="next_button">
                                <property name="label" translatable="yes">Next →</property>
                                <property name="css_classes">suggested-action navigation-button next-button</property>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>
    </object>
</interface>
